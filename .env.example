# 复制为 .env 后按需修改；所有变量以 SL_ 为前缀

# dev / test / prod（prod 输出 JSON 结构化日志）
SL_ENVIRONMENT=dev

# JWT 签名密钥，生产必须更换
SL_SECRET_KEY=dev-secret-change-me

# SQLite 本地零依赖；生产换 postgresql+asyncpg://...
SL_DATABASE_URL=sqlite+aiosqlite:///./shortlink.db

# 留空 = 内存版降级实现（限流/缓存/锁）；填 redis://... 即启用 Redis 后端
SL_REDIS_URL=

# 对外展示域名（拼 short_url 用）
SL_PUBLIC_BASE_URL=http://127.0.0.1:8000

# 雪花 ID 机器号 0-1023，多实例部署时必须不同
SL_MACHINE_ID=1

# 令牌桶限流：每分钟每 IP
SL_RATE_LIMIT_API_PER_MINUTE=120
SL_RATE_LIMIT_REDIRECT_PER_MINUTE=600

# 点击埋点批写：队列容量 / 刷盘间隔秒 / 单批条数
SL_CLICK_QUEUE_SIZE=10000
SL_CLICK_FLUSH_INTERVAL=2.0
SL_CLICK_FLUSH_BATCH=500

# 密码 pbkdf2 迭代次数
SL_PASSWORD_PBKDF2_ITERATIONS=200000
